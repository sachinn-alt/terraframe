# Terraframe Environment Configuration
# Copy this file to .env.local to configure your own credentials

# Google Gemini API for Multimodal Environmental Vision Reasoning
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cloudinary Media Intelligence Pipeline
# Get your free credentials at: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=terraframe-demo
CLOUDINARY_CLOUD_NAME=terraframe-demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
